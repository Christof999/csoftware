# ─── Öffentliche (Client) Variablen ─────────────────────────────────────────
# Öffentliche Site-URL (Canonical, Open Graph, JSON-LD) — ohne Slash am Ende
# Beispiel: https://www.soergel-design.de
VITE_SITE_URL=

# Öffentliche Kontakt-E-Mail (wird auf der Kontaktseite angezeigt)
# Standard im Code: info@soergel-design.de
VITE_CONTACT_EMAIL=

# ─── Server-seitig (Vercel Serverless Function /api/contact) ────────────────
# SMTP-Zugang (z. B. checkdomain)
# Host & Port entnehmen Sie dem Webmail-/Kundenbereich Ihres Providers.
# Typisch für checkdomain:
#   SMTP_HOST=smtp.checkdomain.de
#   SMTP_PORT=587   (STARTTLS)  -> oder 465 für implizites SSL
SMTP_HOST=smtp.checkdomain.de
SMTP_PORT=587
SMTP_USER=info@soergel-design.de
SMTP_PASSWORD=

# Empfängeradresse (wohin das Kontaktformular geschickt wird)
CONTACT_TO=info@soergel-design.de

# Absender der ausgehenden E-Mail – muss ein Postfach auf der eigenen Domain sein,
# sonst lehnt der SMTP-Server den Versand i. d. R. ab.
CONTACT_FROM="SØRGEL-design <info@soergel-design.de>"

# ─── Firebase (Blog 2 — Firestore) ───────────────────────────────────────────
# Web-App-Konfiguration aus Firebase Console → Projekteinstellungen → Ihre Apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Name der Firestore-Sammlung mit Blog-Beiträgen (Standard: posts)
VITE_FIRESTORE_BLOG_COLLECTION=posts
